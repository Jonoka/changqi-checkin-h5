{
  "name": "changqi-checkin-h5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "start": "node server/index.js",
    "check": "node scripts/check-config.mjs && node scripts/check-http.mjs && node --test scripts/a1-unit.test.mjs scripts/a2-unit.test.mjs scripts/a3-unit.test.mjs scripts/a4-unit.test.mjs scripts/point-qrs.test.mjs",
    "test:a1:mysql": "node scripts/check-a1-mysql.mjs",
    "test:a2:mysql": "node scripts/check-a1-mysql.mjs --a2",
    "test:a3:mysql": "node scripts/check-a1-mysql.mjs --a3",
    "test:a4:mysql": "node scripts/check-a1-mysql.mjs --a4",
    "qr:points": "node scripts/generate-point-qrs.mjs",
    "db:schema": "node scripts/apply-schema.mjs",
    "build": "vite build --config web/vite.config.js"
  },
  "dependencies": {
    "dotenv": "18.0.1",
    "express": "5.2.1",
    "express-basic-auth": "1.2.1",
    "express-mysql-session": "3.0.3",
    "express-session": "1.19.0",
    "multer": "2.4.0",
    "mysql2": "3.24.4",
    "qrcode": "1.5.4",
    "sharp": "0.35.4",
    "vue": "3.5.43"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "8.3.0"
  }
}
