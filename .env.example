# v1.3 初始化占位样例：尚无应用代码，不代表可直接启动。
# A0 实现时保留此接口约定，必要变更同步 SPEC 与 README。
# 复制为 .env 后在本地填写；真实 .env 不提交 GitHub。
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
TZ=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=changqi_checkin
DB_USER=
DB_PASSWORD=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
SESSION_SECRET=

# 本地示例；生产改为构建包外的绝对持久目录。
UPLOAD_DIR=./var/uploads
# 仅开发环境显式开启；生产不能启用。
DEV_MOCK_ENABLED=false

# /stats 固定凭据由 Nginx Basic Auth 等现成方式管理，
# 不在这里创建工作人员账号，不提交 .htpasswd。
